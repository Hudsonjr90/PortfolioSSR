# Neon PostgreSQL — obtenha em https://neon.tech
# O DATABASE_URL usa connection pooling (porta 5432 via pgBouncer)
# O DIRECT_URL é a conexão direta (necessário para migrations com Prisma)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# better-auth — gere um segredo aleatório forte
# Exemplo: openssl rand -base64 32
BETTER_AUTH_SECRET="seu-segredo-super-secreto"

# URL base da aplicação (sem barra final)
BETTER_AUTH_URL="http://localhost:3000"
NUXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend — obtenha em https://resend.com (3.000 emails/mês grátis)
RESEND_API_KEY="re_xxxxxxxxxxxx"
